{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build",
  "outputDirectory": ".",
  "redirects": [
    {"source":"/:path*","has":[{"type":"host","value":"amjadblacksmith.com"}],"destination":"https://www.amjadblacksmith.com/:path*","permanent":true},
    {"source":"/index.html","destination":"/","permanent":true},
    {"source":"/:service/index.html","destination":"/:service/","permanent":true}
  ]
}
